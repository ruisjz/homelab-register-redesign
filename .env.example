# Copiar para .env e preencher. O .env nunca vai para o git nem para a imagem Docker.

# Obrigatórios: credenciais de acesso à app.
AUTH_USERNAME=
AUTH_PASSWORD=

# true com HTTPS (VPS atrás do HAProxy); false em casa, por http://IP.
COOKIE_SECURE=true

# IPs ou redes do proxy à frente da app, separados por vírgulas (ex.: 10.0.0.5,10.0.0.0/24).
# Vazio sem proxy. Um valor inválido impede o arranque. Ver tests/FASE2.md para o descobrir.
TRUSTED_PROXY_IPS=

# Snapshots automáticos guardados em data/backups/ (antes de restore e de migração), por tipo.
AUTO_BACKUPS_KEEP=5
